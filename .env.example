# Copy to .env for local runs. Compose files set their own development values.
# The API and worker use the non-superuser tenant role; migrations use a privileged DSN.
DATABASE_URL=postgres://email_app:app-dev@localhost:5432/email_platform_dev?sslmode=disable
MIGRATION_DATABASE_URL=postgres://postgres:password@localhost:5432/email_platform_dev?sslmode=disable
REDIS_URL=redis://localhost:6379
LISTEN_ADDR=:8080
LOG_LEVEL=info

# Use STORAGE_ACCESS_KEY_FILE and STORAGE_SECRET_KEY_FILE for mounted secrets.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=email-platform
STORAGE_ACCESS_KEY=test-access-key
STORAGE_SECRET_KEY=test-secret-key

# Use MASTER_KEY_FILE for a mounted encryption key.
MASTER_KEY=dev-only-master-key-not-for-production

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com
